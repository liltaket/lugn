# systemd user unit for the host that runs Lugn.
#   install -Dm644 systemd/lugn-door-bridge.service ~/.config/systemd/user/lugn-door-bridge.service
#   systemctl --user daemon-reload && systemctl --user enable --now lugn-door-bridge
# Expects: venv at %h/.local/share/lugn-door-bridge/venv (pip install -r requirements.txt),
# the code of the active release at %h/.local/lib/lugn-door-bridge/current (a symlink
# to one release directory, so a release switch is a symlink change plus restart),
# config at %E/lugn-door-bridge/config.toml, and an environment file (mode 600)
# holding only the variables the config names, e.g.
#   LUGN_API_TOKEN_B64=<same value as in Lugn's environment>
#   STT_TOKEN=<the STT worker's token>
[Unit]
Description=Lugn door node bridge (voice + adaptive-volume data)
After=network-online.target lugn.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/lugn-door-bridge/current
ExecStart=%h/.local/share/lugn-door-bridge/venv/bin/python -m door_bridge run --config %E/lugn-door-bridge/config.toml
EnvironmentFile=%E/lugn-door-bridge/environment
UMask=0077
Restart=always
RestartSec=5
# The lidar pipeline owns the CPU; the bridge yields.
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=120M
MemoryHigh=96M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
