{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lugn computer events v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "sequence",
    "timestamp_ms",
    "type"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 512
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 512
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "const": "state_changed"
    }
  }
}
