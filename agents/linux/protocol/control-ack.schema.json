{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lugn targeted media control ack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "connection_id",
    "command_id",
    "action",
    "player",
    "player_instance_id",
    "content_id",
    "timestamp_ms",
    "outcome",
    "reason",
    "resume_token",
    "lease_expires_at_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "command_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "action": {
      "enum": ["pause", "resume"]
    },
    "player": {
      "type": "string",
      "pattern": "^org\\.mpris\\.MediaPlayer2\\.[A-Za-z_-][A-Za-z0-9_-]*(\\.[A-Za-z_-][A-Za-z0-9_-]*)*$",
      "maxLength": 255
    },
    "player_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "content_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "enum": ["applied", "rejected", "uncertain"]
    },
    "reason": {
      "enum": [
        "paused",
        "resumed",
        "disabled",
        "retained",
        "expired",
        "invalid_command",
        "wrong_session",
        "wrong_connection",
        "unknown_player",
        "player_changed",
        "content_changed",
        "not_playing",
        "not_paused",
        "not_capable",
        "not_owner",
        "lease_expired",
        "id_conflict",
        "busy",
        "unavailable",
        "timeout",
        "unconfirmed"
      ]
    },
    "resume_token": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "lease_expires_at_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
