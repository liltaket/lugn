{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lugn display power acknowledgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "connection_id",
    "command_id",
    "action",
    "timestamp_ms",
    "outcome",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "command_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "action": { "enum": ["off", "on"] },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": { "enum": ["applied", "rejected", "uncertain"] },
    "reason": {
      "enum": [
        "display_off",
        "display_on",
        "retained",
        "expired",
        "invalid_command",
        "wrong_session",
        "wrong_connection",
        "id_conflict",
        "busy",
        "unavailable",
        "timeout",
        "failed"
      ]
    }
  }
}
