{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lugn targeted media control command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "connection_id",
    "command_id",
    "action",
    "player",
    "player_instance_id",
    "content_id",
    "issued_at_ms",
    "expires_at_ms",
    "pause_command_id",
    "resume_token",
    "lease_ttl_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "command_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "action": {
      "enum": ["pause", "resume"]
    },
    "player": {
      "type": "string",
      "pattern": "^org\\.mpris\\.MediaPlayer2\\.[A-Za-z_-][A-Za-z0-9_-]*(\\.[A-Za-z_-][A-Za-z0-9_-]*)*$",
      "maxLength": 255
    },
    "player_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "content_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pause_command_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_token": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "lease_ttl_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "action": {
          "const": "pause"
        },
        "pause_command_id": {
          "type": "null"
        },
        "resume_token": {
          "type": "null"
        },
        "lease_ttl_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "resume"
        },
        "pause_command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "resume_token": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "lease_ttl_ms": {
          "type": "null"
        }
      }
    }
  ]
}
