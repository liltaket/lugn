{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lugn targeted media control state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "session_id",
    "connection_id",
    "sequence",
    "timestamp_ms",
    "heartbeat_interval_ms",
    "players"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "heartbeat_interval_ms": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 300000
    },
    "players": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "player",
          "player_instance_id",
          "content_id",
          "playback_status",
          "can_pause",
          "can_play",
          "pause_lease"
        ],
        "properties": {
          "player": {
            "type": "string",
            "pattern": "^org\\.mpris\\.MediaPlayer2\\.[A-Za-z_-][A-Za-z0-9_-]*(\\.[A-Za-z_-][A-Za-z0-9_-]*)*$",
            "maxLength": 255
          },
          "player_instance_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "maxLength": 36
          },
          "content_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ]
          },
          "playback_status": {
            "anyOf": [
              {
                "enum": [
                  "Playing",
                  "Paused",
                  "Stopped"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "can_pause": {
            "type": "boolean"
          },
          "can_play": {
            "type": "boolean"
          },
          "pause_lease": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pause_command_id",
                  "resume_token",
                  "expires_at_ms"
                ],
                "properties": {
                  "pause_command_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "maxLength": 36
                  },
                  "resume_token": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "maxLength": 36
                  },
                  "expires_at_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
